# ============================================================
# 电力新闻资讯前端 —— 环境变量模板
# 用法：cp .env.example .env.local  然后按实际环境填写
# 所有变量必须以 VITE_ 开头才会被 Vite 注入到前端代码里。
# ============================================================

# 中台 API 前缀。开发态由 vite.config.js 的 proxy 转发到 127.0.0.1:8123，
# 因此这里保持相对路径即可；生产同域部署也不用改。
VITE_API_BASE=/api/v1

# 中台 API Key（Bearer）。留空时应用会提示去设置页填写，不会静默返回空列表。
# 本机开发可直接用 .workbuddy/e2e_token 里缓存的那个。
VITE_API_TOKEN=

# AI 能力来源：auto | http | local | llm
#   http  —— 走中台 AI 接口（/news/summary 等），需要中台配好 LLM
#   local —— 全部走浏览器本地规则实现，无后端也能演示
#   llm   —— 走下方预留的**大模型标准接口**（需求 2，联调入口）
#   auto  —— 优先 http，失败自动降级到 local（默认，推荐）
VITE_AI_PROVIDER=auto

# ============================================================
# 大模型标准接口（需求 2 预留，待联调）
# 对方提供「接口地址 / 认证参数 / 模型名」后，只填这三行即可上线，
# 不需要改任何代码。协议为 OpenAI 兼容的 POST {API_URL}/chat/completions。
# ============================================================
# 不要带 /chat/completions 后缀，例：https://api.example.com/v1
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=
VITE_LLM_TIMEOUT_MS=60000
# 推理型模型的思考过程计入输出长度，上限给大些（按实际用量计费，不浪费）
VITE_LLM_MAX_TOKENS=8000

# 定时拉取间隔（毫秒）。默认 2 小时 = 7200000。
VITE_POLL_INTERVAL_MS=7200000
