# ============================================================
# Power News Aggregator —— 环境变量模板
# 用法：cp .env.example .env  然后按实际环境填写
# .env 不提交版本库（见 .gitignore）
# ============================================================

# ---------- 采集库（newsagg）MySQL ----------
POWERNEWS_MYSQL_HOST=127.0.0.1
POWERNEWS_MYSQL_PORT=3306
POWERNEWS_MYSQL_USER=powernews
POWERNEWS_MYSQL_PASSWORD=
POWERNEWS_MYSQL_DATABASE=powernews
POWERNEWS_MYSQL_CHARSET=utf8mb4

# ---------- Redis（任务队列 + 布隆去重位图）----------
# 注意：本机既有 News Aggregator 项目使用 6380，两个项目请勿共用同一个库
POWERNEWS_REDIS_URL=redis://127.0.0.1:6379/0
POWERNEWS_QUEUE_STREAM=powernews:site_jobs
POWERNEWS_QUEUE_GROUP=powernews-workers

# ---------- 采集行为 ----------
POWERNEWS_CONCURRENCY=8
POWERNEWS_DOWNLOAD_TIMEOUT=30
POWERNEWS_AUTOTHROTTLE_MAX_DELAY=60
POWERNEWS_LEASE_SECONDS=900
POWERNEWS_WORKER_COUNT=4
POWERNEWS_USER_AGENT=powernews/0.1 (educational local aggregator)
POWERNEWS_LOG_DIR=
POWERNEWS_LOG_LEVEL=INFO

# ---------- 窗口（天）----------
POWERNEWS_WINDOW_DAYS=7
POWERNEWS_INCREMENTAL_LOOKBACK_HOURS=48

# ---------- 正文抽取 ----------
# 专用适配器解析失败时是否启用 GNE 通用抽取兜底
POWERNEWS_GNE_FALLBACK=true
POWERNEWS_SIMHASH_THRESHOLD=3

# ---------- 数据中台（newsplatform）----------
# 中台自有库（可写）：api_keys / audit_logs / stats_snapshots
POWERNEWS_PLATFORM_DATABASE_URL=mysql+aiomysql://powernews:password@127.0.0.1:3306/powernews_platform?charset=utf8mb4
# 采集库（只读语义）：articles / sources / provinces / crawl_jobs
# 注意：必须显式配置，否则会回落到源码里的 CHANGE_ME 占位口令 → 采集库认证失败
POWERNEWS_PLATFORM_COLLECTOR_DATABASE_URL=mysql+aiomysql://powernews:password@127.0.0.1:3306/powernews?charset=utf8mb4
# 省级新闻库（只读，**可选**）：newsagg 的 articles / sources / provinces
# 留空 = 不接入省级数据域：channel=province 返回 503，channel=all 自动降级为 power
POWERNEWS_PLATFORM_PROVINCE_DATABASE_URL=
# 引导令牌：库内尚无 API Key 时用它访问 /admin 初始化第一把 Key；留空即禁用
POWERNEWS_PLATFORM_BOOTSTRAP_ADMIN_TOKEN=
POWERNEWS_PLATFORM_REDIS_URL=redis://127.0.0.1:6379/1
POWERNEWS_PLATFORM_HOST=0.0.0.0
POWERNEWS_PLATFORM_PORT=8000
POWERNEWS_PLATFORM_DEBUG=false
POWERNEWS_PLATFORM_CORS_ORIGINS=["http://localhost:3000"]
POWERNEWS_PLATFORM_SECRET_KEY=change-me-in-production
POWERNEWS_PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=120
POWERNEWS_PLATFORM_RATE_LIMIT_PER_MINUTE=120

# ---------- 电力新闻智能总结（/api/v1/news/summary）----------
# 默认关闭。关闭时该接口**仍然可用**，走仓库自带的抽取式摘要
# （确定性算法，不依赖任何外部模型），响应里的 method 会标为 extractive。
# 打开后 method=auto 会优先调模型，失败自动降级并把原因写进 caveats。
POWERNEWS_PLATFORM_LLM_ENABLED=false
# OpenAI 兼容的 base url（不要带 /chat/completions）。换厂商只改这里 + MODEL。
POWERNEWS_PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
POWERNEWS_PLATFORM_LLM_API_KEY=
POWERNEWS_PLATFORM_LLM_MODEL=gpt-4o-mini
POWERNEWS_PLATFORM_LLM_TIMEOUT_SECONDS=45
# 单次总结最多喂给模型的字符数与最大输出 token（控制费用与延迟）
POWERNEWS_PLATFORM_LLM_MAX_INPUT_CHARS=24000
POWERNEWS_PLATFORM_LLM_MAX_TOKENS=1200

# ============================================================
# docker compose 专用（容器里 DSN 由下面三段现拼，主机名固定为服务名 mysql）
# —— 本机裸跑 uvicorn / CLI 时不需要这些，用上面的 DSN 即可。
# ============================================================
# MySQL 容器 root 口令（仅首次初始化数据卷时生效）
POWERNEWS_MYSQL_ROOT_PASSWORD=root_dev_pwd
# 中台库名：compose 拼 DSN 用，与上面 POWERNEWS_PLATFORM_DATABASE_URL 里的库名保持一致
POWERNEWS_PLATFORM_MYSQL_DATABASE=powernews_platform
# 中台 API 映射到宿主机的端口（同机 8000 常被别的项目占）
POWERNEWS_PLATFORM_HOST_PORT=8080
# worker 容器内 supervisor 拉起的子进程数
POWERNEWS_WORKER_COUNT=2
# 监控栈端口（--profile ops 才用到）
PROMETHEUS_PORT=9090
# Alertmanager：规则的「去处」。能创建静默（等于关告警），介意的话在 compose 里
# 把端口映射改成 127.0.0.1:${ALERTMANAGER_PORT:-9093}:9093
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# 每日备份（power-backup 容器，随核心栈常驻，不需要 --profile）
# 留空=自动枚举所有非系统库（**保持留空**：同实例还有省级库 newsagg）
POWERNEWS_BACKUP_DATABASES=
# 每天几点备（容器时区 Asia/Shanghai）
POWERNEWS_BACKUP_AT=03:30
# 保留几份每日备份
POWERNEWS_BACKUP_RETAIN_DAYS=7

# ============================================================
# 对象存储（RustFS，--profile storage 才用到）
#
# 为什么是 RustFS 而不是 MinIO：MinIO 社区版仓库 2026-04-25 已永久归档，
# 官方声明 "THIS REPOSITORY IS NO LONGER MAINTAINED" 且不再提供预编译二进制。
# 详见 docs/对象存储选型-MinIO与RustFS对比.md
#
# 接入代码一律用 S3 SDK（boto3 + endpoint_url），
# 这样将来换 SeaweedFS / Garage / Ceph 只改 endpoint，业务代码不动。
# ============================================================
# 容器内互相访问用服务名 rustfs；从宿主机或其它机器访问用 IP:9000
POWERNEWS_S3_ENDPOINT=http://rustfs:9000
# 对外（浏览器 / 前端）可访问的地址。它会写进图片 URL，**不能用容器内网名**
POWERNEWS_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
POWERNEWS_S3_BUCKET=powernews-images
# RustFS 要求 access key >= 3 字符、secret >= 8 字符；生产务必换掉
POWERNEWS_S3_ACCESS_KEY=powernews_minio_dev
POWERNEWS_S3_SECRET_KEY=powernews_minio_dev_secret
# 控制台端口（--profile storage 才暴露）
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ============================================================
# 定时调度与重试（schedule --loop / worker 共用）
# ============================================================
# cron 表达式（5 字段：分 时 日 月 星期）。空 = 只用「间隔小时」模式。
# 与 sources.crawl_interval_hours 是**叠加**关系：cron 命中 或 间隔到期，
# 任一满足即建批（trigger_key 不同，不会互相挤掉）。
#   0 8 * * *      每天 08:00（北京时间）
#   0 */2 * * *    每两小时
#   30 8 * * 1     每周一 08:30
#   0 9 1 * *      每月 1 日 09:00
# 非法表达式不会让调度器停摆，只会记 error 并按间隔模式跑（见 schedule.cron_due）
SCHEDULE_CRON=

# 单个 job 最大重试次数。次数来自 Redis Stream 的 XPENDING（times_delivered），
# 不依赖给 crawl_jobs 加列。超过则标记 failed 并 ack，不再重认领。
JOB_MAX_RETRIES=3
# 重试的最小空闲间隔（毫秒）。消息空闲超过该值才被 XAUTOCLAIM 重新认领。
# 立即重试会对着同一个失败原因连打；太长则故障恢复慢。10 分钟是折中。
JOB_RETRY_MIN_IDLE_MS=600000

# ============================================================
# 定时调度与重试（schedule --loop / worker 共用）
# ============================================================
# cron 表达式（5 字段：分 时 日 月 星期）。空 = 只用「间隔小时」模式。
# 与 sources.crawl_interval_hours 是**叠加**关系：cron 命中 或 间隔到期，
# 任一满足即建批（trigger_key 不同，不会互相挤掉）。
#   0 8 * * *      每天 08:00（北京时间）
#   0 */2 * * *    每两小时
#   30 8 * * 1     每周一 08:30
#   0 9 1 * *      每月 1 日 09:00
# 非法表达式不会让调度器停摆，只会记 error 并按间隔模式跑（见 schedule.cron_due）
SCHEDULE_CRON=

# 单个 job 最大重试次数。次数来自 Redis Stream 的 XPENDING（times_delivered），
# 不依赖给 crawl_jobs 加列。超过则标记 failed 并 ack，不再重认领。
JOB_MAX_RETRIES=3
# 重试的最小空闲间隔（毫秒）。消息空闲超过该值才被 XAUTOCLAIM 重新认领。
# 立即重试会对着同一个失败原因连打；太长则故障恢复慢。10 分钟是折中。
JOB_RETRY_MIN_IDLE_MS=600000
