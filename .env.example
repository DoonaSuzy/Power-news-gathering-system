# ============================================================
# Power News Aggregator —— 环境变量模板
# 用法：cp .env.example .env  然后按实际环境填写
# .env 不提交版本库（见 .gitignore）
# ============================================================

# ---------- 采集库（newsagg）MySQL ----------
POWERNEWS_MYSQL_HOST=127.0.0.1
POWERNEWS_MYSQL_PORT=3306
POWERNEWS_MYSQL_USER=powernews
POWERNEWS_MYSQL_PASSWORD=
POWERNEWS_MYSQL_DATABASE=powernews
POWERNEWS_MYSQL_CHARSET=utf8mb4

# ---------- Redis（任务队列 + 布隆去重位图）----------
# 注意：本机既有 News Aggregator 项目使用 6380，两个项目请勿共用同一个库
POWERNEWS_REDIS_URL=redis://127.0.0.1:6379/0
POWERNEWS_QUEUE_STREAM=powernews:site_jobs
POWERNEWS_QUEUE_GROUP=powernews-workers

# ---------- 采集行为 ----------
POWERNEWS_CONCURRENCY=8
POWERNEWS_DOWNLOAD_TIMEOUT=30
POWERNEWS_AUTOTHROTTLE_MAX_DELAY=60
POWERNEWS_LEASE_SECONDS=900
POWERNEWS_WORKER_COUNT=4
POWERNEWS_USER_AGENT=powernews/0.1 (educational local aggregator)
POWERNEWS_LOG_DIR=
POWERNEWS_LOG_LEVEL=INFO

# ---------- 窗口（天）----------
POWERNEWS_WINDOW_DAYS=7
POWERNEWS_INCREMENTAL_LOOKBACK_HOURS=48

# ---------- 正文抽取 ----------
# 专用适配器解析失败时是否启用 GNE 通用抽取兜底
POWERNEWS_GNE_FALLBACK=true
POWERNEWS_SIMHASH_THRESHOLD=3

# ---------- 数据中台（newsplatform）----------
# 中台自有库（可写）：api_keys / audit_logs / stats_snapshots
POWERNEWS_PLATFORM_DATABASE_URL=mysql+aiomysql://powernews:password@127.0.0.1:3306/powernews_platform?charset=utf8mb4
# 采集库（只读语义）：articles / sources / provinces / crawl_jobs
# 注意：必须显式配置，否则会回落到源码里的 CHANGE_ME 占位口令 → 采集库认证失败
POWERNEWS_PLATFORM_COLLECTOR_DATABASE_URL=mysql+aiomysql://powernews:password@127.0.0.1:3306/powernews?charset=utf8mb4
# 引导令牌：库内尚无 API Key 时用它访问 /admin 初始化第一把 Key；留空即禁用
POWERNEWS_PLATFORM_BOOTSTRAP_ADMIN_TOKEN=
POWERNEWS_PLATFORM_REDIS_URL=redis://127.0.0.1:6379/1
POWERNEWS_PLATFORM_HOST=0.0.0.0
POWERNEWS_PLATFORM_PORT=8000
POWERNEWS_PLATFORM_DEBUG=false
POWERNEWS_PLATFORM_CORS_ORIGINS=["http://localhost:3000"]
POWERNEWS_PLATFORM_SECRET_KEY=change-me-in-production
POWERNEWS_PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=120
POWERNEWS_PLATFORM_RATE_LIMIT_PER_MINUTE=120

# ============================================================
# docker compose 专用（容器里 DSN 由下面三段现拼，主机名固定为服务名 mysql）
# —— 本机裸跑 uvicorn / CLI 时不需要这些，用上面的 DSN 即可。
# ============================================================
# MySQL 容器 root 口令（仅首次初始化数据卷时生效）
POWERNEWS_MYSQL_ROOT_PASSWORD=root_dev_pwd
# 中台库名：compose 拼 DSN 用，与上面 POWERNEWS_PLATFORM_DATABASE_URL 里的库名保持一致
POWERNEWS_PLATFORM_MYSQL_DATABASE=powernews_platform
# 中台 API 映射到宿主机的端口（同机 8000 常被别的项目占）
POWERNEWS_PLATFORM_HOST_PORT=8080
# worker 容器内 supervisor 拉起的子进程数
POWERNEWS_WORKER_COUNT=2
# 监控栈端口（--profile ops 才用到）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
