# ============================================================
# Power News Aggregator —— 生产环境 .env 安全指南
# ============================================================
# ⚠️ 本文件为示例，**不得包含真实凭据**
# ⚠️ 真实 .env 必须从密钥管理系统（Vault/Docker Secret/K8s）动态注入
# ============================================================

# ---------- MySQL（采集库 + 中台库）----------
# ✅ 部署脚本应使用 `docker exec mysql mysql -u root -p$MYSQL_ROOT_PASSWORD` 等命令自动注入
POWERNEWS_MYSQL_HOST=${DOCKER_SERVICE_MYSQL_HOST}
POWERNEWS_MYSQL_PORT=3306
POWERNEWS_MYSQL_USER=powernews
POWERNEWS_MYSQL_PASSWORD=$SECRET_POWERNEWS_MYSQL_PASSWORD
POWERNEWS_MYSQL_DATABASE=powernews
POWERNEWS_MYSQL_CHARSET=utf8mb4

# ---------- Redis（任务队列 + 布隆去重位图）----------
# ✅ 启用 ACL + TLS 加密
POWERNEWS_REDIS_URL=redis://$REDIS_HOST:6379/0?password=$SECRET_REDIS_PASSWORD&ssl=true
POWERNEWS_QUEUE_STREAM=powernews:site_jobs
POWERNEWS_QUEUE_GROUP=powernews-workers

# ---------- 数据中台（newsplatform）----------
# ✅ 生产环境务必使用强随机字符串（至少 32 字符）
# ✅ SECRET_KEY 建议使用 openssl rand -hex 32
POWERNEWS_PLATFORM_DATABASE_URL=mysql+aiomysql://powernews:$SECRET_MYSQL_PASSWORD@mysql:3306/powernews_platform?charset=utf8mb4
POWERNEWS_PLATFORM_COLLECTOR_DATABASE_URL=mysql+aiomysql://powernews:$SECRET_MYSQL_PASSWORD@mysql:3306/powernews?charset=utf8mb4
# 省级新闻库（只读，可选）：留空则不接入，channel=province 返回 503
POWERNEWS_PLATFORM_PROVINCE_DATABASE_URL=
POWERNEWS_PLATFORM_BOOTSTRAP_ADMIN_TOKEN=$SECRET_BOOTSTRAP_ADMIN_TOKEN
POWERNEWS_PLATFORM_REDIS_URL=redis://$REDIS_HOST:6379/1
POWERNEWS_PLATFORM_HOST=0.0.0.0
POWERNEWS_PLATFORM_PORT=8000
POWERNEWS_PLATFORM_DEBUG=false
POWERNEWS_PLATFORM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000"]
POWERNEWS_PLATFORM_SECRET_KEY=$SECRET_PLATFORM_SECRET_KEY
POWERNEWS_PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=120
POWERNEWS_PLATFORM_RATE_LIMIT_PER_MINUTE=120

# ---------- 公告栏服务端预生成（LLM）----------
# ✅ LLM_ENABLED 默认关闭（fallback 到抽取式摘要）
# ✅ API_KEY 从 Vault/K8s Secret 注入
POWERNEWS_PLATFORM_LLM_ENABLED=${LLM_ENABLED:false}
POWERNEWS_PLATFORM_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
POWERNEWS_PLATFORM_LLM_API_KEY=$SECRET_LLMP_API_KEY
POWERNEWS_PLATFORM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
POWERNEWS_PLATFORM_LLM_TIMEOUT_SECONDS=90
POWERNEWS_PLATFORM_LLM_MAX_TOKENS=16000
POWERNEWS_NOTICE_INTERVAL_SECONDS=7200

# ==== 对象存储（RustFS）====
# ✅ 生产环境禁用公开读桶策略，改用签名 URL
POWERNEWS_S3_ENDPOINT=https://rustfs.powernews.internal:9000
POWERNEWS_S3_PUBLIC_ENDPOINT=https://images.powernews.internal
POWERNEWS_S3_BUCKET=powernews-images
POWERNEWS_S3_ACCESS_KEY=$SECRET_S3_ACCESS_KEY
POWERNEWS_S3_SECRET_KEY=$SECRET_S3_SECRET_KEY
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ============================================================
# 部署脚本建议：
# 1. docker compose --profile ops up -d --scale worker=4
# 2. vault agent -template=.env.template.hcl:/run/secrets/.env
# 3. reload services: docker compose restart newsplatform
# ============================================================
